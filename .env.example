OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Academic literature research (optional; these are the defaults)
ACADEMIC_SEARCH_ENABLED=true
CROSSREF_ENRICHMENT_ENABLED=true
CITATION_VERIFICATION_ENABLED=true
MAX_PAPERS_PER_QUERY=10
MAX_ACADEMIC_PAPERS=20
SEMANTIC_SCHOLAR_ENABLED=true
SEMANTIC_SCHOLAR_ENRICHMENT_ENABLED=true
ACADEMIC_IMPACT_WEIGHT=0.2
# Optional: improves Semantic Scholar rate limits
SEMANTIC_SCHOLAR_API_KEY=
# PUBLICATION_YEAR_START=2023
# PUBLICATION_YEAR_END=2026

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false
